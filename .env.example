# Copy to .env for local dev. NEVER commit the real file — .env is gitignored.
# On Render, set these in the dashboard as environment variables instead.

# Claude vision: turns a scanned object into five property scores + a weapon name.
ANTHROPIC_API_KEY=sk-ant-...

# Reactor X2: the spectator broadcast. Optional — the game runs fine without it.
REACTOR_API_KEY=rk_...

# Optional overrides
# VISION_MODEL=claude-sonnet-4-6
# PORT=8090
